{
  "name": "weas",
  "version": "0.2.10",
  "description": "WEAS (Web Environment for Atomic Structures) is a JavaScript library to visualize and manipulate atomistic structures in the browser",
  "main": "dist/index.cjs.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    }
  },
  "type": "module",
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:iife",
    "build:esm": "vite build",
    "build:iife": "vite build --mode iife",
    "dev": "vite",
    "sync-version": "node scripts/sync-version.cjs",
    "test": "jest",
    "version": "node scripts/sync-version.cjs",
    "docs": "documentation build src/** -f html -o docs && npx serve docs"
  },
  "peerDependencies": {
    "dat.gui": "^0.7.9",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.1",
    "@types/node": "^20.11.24",
    "docdash": "^2.0.2",
    "documentation": "^14.0.3",
    "jsdom": "^29.0.1",
    "vite": "^8.0.4",
    "vite-plugin-css-injected-by-js": "^4.0.1",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.3"
  },
  "license": "MIT",
  "author": "Xing Wang",
  "repository": {
    "type": "git",
    "url": "https://github.com/superstar54/weas.git"
  },
  "keywords": [
    "weas",
    "3d",
    "atoms",
    "threejs",
    "visualization"
  ],
  "dependencies": {
    "lodash.merge": "^4.6.2",
    "mathjs": "^15.1.1"
  }
}
